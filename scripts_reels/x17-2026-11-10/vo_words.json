 "segments": [
  {
   "start": 0.0,
   "end": 2.36,
   "text": "عندك ايفون، وناسي رمز الاي كلاود؟"
  },
  {
   "start": 2.36,
   "end": 5.04,
   "text": "لا تفرمت جهازك، قبل لا تشوف هذا."
  },
  {
   "start": 5.26,
   "end": 8.2,
   "text": "من ايفون اكس، للسبعطعش، وبرو ماكس."
  },
  {
   "start": 8.34,
   "end": 13.48,
   "text": "احنا نخطي لك القفل، والخط يشتغل عادي، بسرعة، وبسعر مناسب."
  },
  {
   "start": 13.66,
   "end": 17.86,
   "text": "ملاحظة مهمة، الاجهزة المبلغ عنها فقدان، ما نشتغلها."
  },
  {
   "start": 18.1,
   "end": 22.06,
   "text": "جي فاير للموبايل، النجف، ميلاد، شارع الحولي."
  },
  {
   "start": 22.12,
   "end": 25.72,
   "text": "ناسي رمز الاي كلاود؟ لا تفرمت، تعال لجي فاير."
  }
 ],
