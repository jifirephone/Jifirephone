 "segments": [
  {
   "start": 0.0,
   "end": 2.58,
   "text": "موبايل بالقسط، ويوصلك لباب البيت؟"
  },
  {
   "start": 2.58,
   "end": 7.62,
   "text": "خلينا نقول، حيدر يريد موبايل جديد، بس الفلوس ما تكفي كاش."
  },
  {
   "start": 7.74,
   "end": 10.18,
   "text": "راح لجي فاير للموبايل بالنجف."
  },
  {
   "start": 10.34,
   "end": 16.86,
   "text": "بالمحل اكو اجهزة، اكسسوارات، صيانة، وخطوط، وشغلهم نظيف، وسعرهم مناسب."
  },
  {
   "start": 17.04,
   "end": 22.74,
   "text": "حيدر اخذ موبايله بالقسط، وصديقة علي اخذ iPhone 18 Pro Max نقد."
  },
  {
   "start": 22.94,
   "end": 27.9,
   "text": "والأحلى، عدهم تطبيق، تطلب منه اي شيء، ويوصلك لباب البيت."
  },
  {
   "start": 27.9,
   "end": 29.5,
   "text": "جي فاير للموبايل"
  },
  {
   "start": 29.5,
   "end": 31.98,
   "text": "النجف ميلاد شارع الحولي"
  },
  {
   "start": 31.98,
   "end": 33.5,
   "text": "تريد موبايل بالقسط؟"
  },
  {
   "start": 33.5,
   "end": 36.12,
   "text": "تفضل زورنا أو أطلب من خلال تطبيقنا"
  },
  {
   "start": 36.12,
   "end": 38.98,
   "text": "ومباشر ثاني يوم يوصلك الباب بيتك"
  }
 ],
