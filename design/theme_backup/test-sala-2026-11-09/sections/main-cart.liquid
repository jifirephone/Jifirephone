<style>
@media (max-width: 749px) {
  #main-cart td.cart-item__totals.jf-cart-original-mobile-total,
  #main-cart td.cart-item__totals.jf-cart-original-mobile-total * {
    display: none !important;
  }
}
</style>
<style>
@media screen and (max-width:749px) {
  #main-cart td.cart-item__details .jf-cart-duplicate-detail-price,
  #main-cart td.cart-item__details .jf-cart-duplicate-detail-price * {
    display:none !important;
  }
}
</style>
<style>
@media screen and (max-width:749px) {
  #main-cart .cart-item__details .jf-cart-desktop-detail-price,
  #main-cart .cart-item__details .jf-cart-desktop-detail-price * { display:none !important; }
  #main-cart .cart-item__details .jf-cart-title-price-row { display:flex !important; }
  #main-cart .cart-item__details .jf-cart-title-price-row .jf-cart-inline-price { display:block !important; }
}
@media screen and (min-width:750px) {
  #main-cart .cart-item__details .jf-cart-desktop-detail-price {display:block !important;}
}
</style>
