<style>
/* Ji Fire: mobile cart readability and checkout */
#main-cart .cart__checkout-button{min-height:52px;border-radius:14px;font-weight:800}
#main-cart .cart__footer{min-width:0}
#main-cart .totals__total-value{font-variant-numeric:tabular-nums}
#main-cart .cart-item__name{overflow-wrap:anywhere;line-height:1.5}
#main-cart :is(button,a,input):focus-visible{outline:3px solid #d7ab38;outline-offset:2px}
@media(max-width:749px){
#main-cart .cart-container{min-width:0}
#main-cart .cart-item{border-bottom:1px solid #edf0f5}
#main-cart .cart-item__media{min-width:0}
#main-cart .cart-item__details{min-width:0}
#main-cart .cart__footer{padding-bottom:22px}
#main-cart .cart__checkout-button{width:100%;max-width:none}
#main-cart .title-wrapper-with-link{gap:12px;flex-wrap:wrap}
}
</style>
